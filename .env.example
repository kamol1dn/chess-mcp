# Copy to .env and adjust. All settings are optional.

# Needed only for "Claude API" players (the server calls Claude directly).
ANTHROPIC_API_KEY=

# Network
PORT=8787
HOST=127.0.0.1
# Base URL shown to agents and in join instructions (set this behind a proxy / in Docker)
CHESS_PUBLIC_URL=http://localhost:8787
# Trust X-Forwarded-* headers from a reverse proxy
CHESS_TRUST_PROXY=false

# When set, creating games, claiming seats and the /mcp endpoint require
# "Authorization: Bearer <key>". Watching games stays public.
CHESS_API_KEY=

# Storage (SQLite)
CHESS_DATA_DIR=./data
# CHESS_DB=./data/chess.db

# Gameplay
CHESS_MOVE_DELAY_MS=400        # pause before engine/Claude moves so spectators can follow
CHESS_ANALYSIS_MS=300          # engine time per position for the eval bar (0 disables)
CHESS_ENGINE_THREADS=          # worker threads for the engine (default: CPUs-1, max 4)
CHESS_LLM_MAX_ATTEMPTS=3       # illegal answers a Claude player may give before forfeiting
CHESS_MAX_ACTIVE_GAMES=200
CHESS_IDLE_TIMEOUT_HOURS=24    # abort games with no activity (0 disables)
CHESS_RATE_LIMIT=300           # write requests per minute per IP
LOG_LEVEL=info
